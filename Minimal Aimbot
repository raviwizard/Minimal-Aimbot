-- Render loop for ESP & Spectate handling
RunService.RenderStepped:Connect(function()
    -- Handle Spectate
    if spectateEnabled then
        local targetPlayer = getPlayer(TargetBox.Text)
        if targetPlayer and targetPlayer.Character then
            local humanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                Camera.CameraSubject = humanoid
            end
        end
    end

    -- Handle ESP (Global or Esp Owl)
    if not aimbotEnabled and not espOwlEnabled then return end

    for _, player in ipairs(targetList) do
        local esp = activeEsp[player]
        if not esp then continue end

        local character = player.Character
        local humanoidRootPart = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if character and humanoidRootPart and humanoid and humanoid.Health > 0 then
            -- Highlight character
            if esp.highlight.Parent ~= character then
                esp.highlight.Parent = character
            end
            esp.highlight.Enabled = true

            local vector, onScreen = Camera:WorldToViewportPoint(humanoidRootPart.Position)
            
            if onScreen then
                local head = character:FindFirstChild("Head")
                local topPosition = head and Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or vector
                local legPosition = Camera:WorldToViewportPoint(humanoidRootPart.Position - Vector3.new(0, 3, 0))
                
                local height = math.abs(topPosition.Y - legPosition.Y)
                local width = height / 2

                -- White Box
                esp.box.Size = Vector2.new(width, height)
                esp.box.Position = Vector2.new(vector.X - width / 2, topPosition.Y)
                esp.box.Visible = true

                -- Info Text (Name, Team, Distance)
                local distance = math.floor((Camera.CFrame.Position - humanoidRootPart.Position).Magnitude)
                local teamName = player.Team and player.Team.Name or "Sem Time"
                
                esp.info.Text = string.format("%s | Time: %s | [%dm]", player.Name, teamName, distance)
                esp.info.Position = Vector2.new(vector.X, topPosition.Y - 18)
                esp.info.Visible = true
            else
                esp.box.Visible = false
                esp.info.Visible = false
            end
        else
            esp.box.Visible = false
            esp.info.Visible = false
            if esp.highlight then
                esp.highlight.Enabled = false
            end
        end
    end
end)

