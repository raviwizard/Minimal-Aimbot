-- Script Logic Variables
local aimbotEnabled = false
local spectateEnabled = false
local espOwlEnabled = false
local activeEsp = {}
local targetList = {}

-- Clean ESP drawings & Highlight
local function removeEsp(player)
    if activeEsp[player] then
        if activeEsp[player].box then activeEsp[player].box:Remove() end
        if activeEsp[player].info then activeEsp[player].info:Remove() end
        if activeEsp[player].highlight then activeEsp[player].highlight:Destroy() end
        activeEsp[player] = nil
    end
end

-- Create ESP visuals & Character Highlight
local function createEsp(player)
    if player == LocalPlayer or activeEsp[player] then return end
    
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Color3.fromRGB(255, 255, 255)
    box.Thickness = 1
    box.Filled = false

    local info = Drawing.new("Text")
    info.Visible = false
    info.Color = Color3.fromRGB(255, 255, 255)
    info.Size = 12
    info.Center = true
    info.Outline = true

    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.65
    highlight.OutlineTransparency = 0
    highlight.Enabled = false

    activeEsp[player] = {box = box, info = info, highlight = highlight}
end

-- Find player by partial name (case-insensitive)
local function getPlayer(nameInput)
    if nameInput == "" then return nil end
    local lowerInput = string.lower(nameInput)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if string.find(string.lower(player.Name), lowerInput, 1, true) or string.find(string.lower(player.DisplayName), lowerInput, 1, true) then
                return player
            end
        end
    end
    return nil
end

-- Sync active targets based on enabled modes
local function syncTargets()
    local newTargets = {}
    local targetSet = {}

    if aimbotEnabled then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                table.insert(newTargets, player)
                targetSet[player] = true
                createEsp(player)
            end
        end
    elseif espOwlEnabled then
        local owlTarget = getPlayer(TargetBox.Text)
        if owlTarget then
            table.insert(newTargets, owlTarget)
            targetSet[owlTarget] = true
            createEsp(owlTarget)
        end
    end

    for player, _ in pairs(activeEsp) do
        if not targetSet[player] then
            removeEsp(player)
        end
    end

    targetList = newTargets
end

-- Automatic target cache refresh every 2 seconds
task.spawn(function()
    while true do
        syncTargets()
        task.wait(2)
    end
end)

-- Manual refresh trigger
RefreshLabel.MouseButton1Click:Connect(function()
